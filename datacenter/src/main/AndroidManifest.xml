<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- 枚举本机所有包，才能找出装在别的包名下的 L3Hub 分支 -->
  <uses-permission
    android:name="android.permission.QUERY_ALL_PACKAGES"
    tools:ignore="QueryAllPackagesPermission" />

  <queries>
    <package android:name="com.rikkahub.l3hub.wfadnf" />
    <package android:name="com.rikkahub.l3hub.wfadnf.canary" />
    <package android:name="com.rikkahub.l3hub.wfadnf.debug" />
  </queries>

  <application
    android:allowBackup="false"
    android:icon="@drawable/ic_data_center"
    android:label="@string/app_name"
    android:roundIcon="@drawable/ic_data_center"
    android:supportsRtl="true"
    android:theme="@style/Theme.DataCenter">
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:label="@string/app_name"
      android:theme="@style/Theme.DataCenter">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
