<?xml version="1.0" encoding="utf-8"?>
<!--
  Outline Toggle 按钮的文字色。

  选中时走 onPrimary（压在主色底上），未选中走 onSurface。
  禁用态压到 38%，与 M3 一致。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_enabled="false" android:color="?attr/colorOnSurface" android:alpha="0.38" />
  <item android:state_checked="true" android:color="?attr/colorOnPrimary" />
  <item android:color="?attr/colorOnSurface" />
</selector>
