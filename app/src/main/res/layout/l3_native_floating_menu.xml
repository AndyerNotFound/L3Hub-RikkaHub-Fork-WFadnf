<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷入口按钮的容器。

  只剩一颗 M3 FAB：点开后的面板由 NativeSelectMenu 画（通用选择菜单），
  不再在这里摆一排横向槽位。

  root 用 match_parent 宽度、内容靠右下角 —— 这样它与输入卡右边界对齐，
  面板展开时往左长，不会顶出屏幕。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/l3_native_floating_menu_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/l3_native_floating_menu_button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:contentDescription="@string/floating_bar_open_menu"
      android:src="@drawable/l3_native_ic_floating_menu"
      app:backgroundTint="?attr/colorSurfaceContainerHigh"
      app:elevation="3dp"
      app:fabCustomSize="56dp"
      app:maxImageSize="24dp"
      app:rippleColor="?attr/colorPrimary"
      app:shapeAppearanceOverlay="@style/ShapeAppearance.L3Hub.FloatingMenu"
      app:tint="?attr/colorOnSurfaceVariant" />
</FrameLayout>
