<?xml version="1.0" encoding="utf-8"?>
<!--
  会话列表的一行。

  三块：多选勾选圈（选中模式下才显示）、标题、行尾状态（置顶图钉 + 运行中的小点）。
  点击进会话，长按开操作菜单 —— 菜单是 NativeSelectMenu，从整行矩形长出来。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/l3_native_conv_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

  <!-- 多选圈：14dp，选中时填主色并打勾 -->
  <FrameLayout
      android:id="@+id/l3_native_conv_check"
      android:layout_width="14dp"
      android:layout_height="14dp"
      android:layout_marginEnd="6dp"
      android:visibility="gone" />

  <TextView
      android:id="@+id/l3_native_conv_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textAppearance="?attr/textAppearanceBodyMedium"
      android:textColor="?attr/colorOnSurface" />

  <FrameLayout
      android:id="@+id/l3_native_conv_pin"
      android:layout_width="12dp"
      android:layout_height="12dp"
      android:layout_marginStart="6dp"
      android:visibility="gone" />

  <!-- 运行中的小圆点：有后台任务在跑时显示 -->
  <View
      android:id="@+id/l3_native_conv_loading"
      android:layout_width="4dp"
      android:layout_height="4dp"
      android:layout_marginStart="6dp"
      android:background="@drawable/l3_native_sidebar_dot"
      android:visibility="gone" />
</LinearLayout>
