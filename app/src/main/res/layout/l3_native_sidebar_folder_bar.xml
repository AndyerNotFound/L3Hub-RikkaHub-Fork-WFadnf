<?xml version="1.0" encoding="utf-8"?>
<!--
  会话文件夹 Tab 条，末尾是排序按钮。

  为什么用 TabLayout 而不是自己排一排胶囊：
  Material 的 TabLayout 自带三件我们要的东西 ——
  - `tabMode="scrollable"`：横向滚动，文件夹多了不挤；
  - `tabIndicatorFullWidth="true"`：指示线占满整个 Tab（Rounded line Full width）；
  - `tabIndicatorAnimationMode="elastic"`：指示线在目标之间拉伸再回弹。
  这最后一条正是 M3 Expressive 那条弹簧曲线，Material 库直接给了
  （TabLayout.INDICATOR_ANIMATION_MODE_ELASTIC），不用自己写。

  指示线本身是 3dp 高、3dp 圆角的圆头线条，颜色走 primary ——
  与 M3 的 PrimaryNavigationTab 规格一致（ActiveIndicatorHeight / ActiveIndicatorShape）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp">

  <!--
    只覆盖三件事，其余全用 Widget.Material3.TabLayout 的默认值：
    - tabMode="scrollable"：横向滚动
    - tabIndicatorFullWidth="true"：指示线占满整个 Tab
    - tabTextAppearance：侧栏窄，用 13sp 而不是默认的 titleSmall

    默认样式里已经有的、不用再写：
    - tabIndicator = @drawable/m3_tabs_rounded_line_indicator（3dp 高、上两角 3dp 圆角）
    - tabIndicatorAnimationMode = elastic（拉伸再回弹）
    - tabIndicatorColor = primary
    - tabUnboundedRipple = false
  -->
  <com.google.android.material.tabs.TabLayout
      android:id="@+id/l3_native_folder_tabs"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:background="@android:color/transparent"
      app:tabGravity="start"
      app:tabIndicatorFullWidth="true"
      app:tabMaxWidth="200dp"
      app:tabMinWidth="72dp"
      app:tabMode="scrollable"
      app:tabPaddingEnd="12dp"
      app:tabPaddingStart="12dp"
      app:tabTextAppearance="@style/TextAppearance.L3Hub.SidebarTab" />

  <!-- 排序按钮：圆形，图标由 ComposeView 填 -->
  <com.google.android.material.card.MaterialCardView
      android:id="@+id/l3_native_sort_card"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:clickable="true"
      android:focusable="true"
      app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
      app:cardCornerRadius="100dp"
      app:cardElevation="0dp"
      app:rippleColor="?attr/colorOnSurface">

    <FrameLayout
        android:id="@+id/l3_native_sort_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_margin="8dp" />
  </com.google.android.material.card.MaterialCardView>
</LinearLayout>
