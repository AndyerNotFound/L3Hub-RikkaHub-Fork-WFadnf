<?xml version="1.0" encoding="utf-8"?>
<!--
  底部那排圆形按钮里的一颗。

  原版是 Surface(CircleShape, primaryContainer) + Box(padding 10dp, size 20dp) + icon()。
  这里用 MaterialCardView 拿圆角与点击涟漪，图标位留一个 FrameLayout 给 ComposeView。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/l3_native_action_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorPrimaryContainer"
    app:cardCornerRadius="100dp"
    app:cardElevation="0dp"
    app:rippleColor="?attr/colorOnSurface">

  <FrameLayout
      android:id="@+id/l3_native_action_icon"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_margin="10dp" />
</com.google.android.material.card.MaterialCardView>
