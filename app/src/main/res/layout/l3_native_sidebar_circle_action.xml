<?xml version="1.0" encoding="utf-8"?>
<!--
  底部那排圆形按钮里的一颗。

  形态是 M3 的 Filled —— 有容器色、没有描边（strokeWidth 0dp）。
  容器色与图标色都由 NativeSidebar#buildCircleAction 从 NativeChatTheme 灌进来；
  XML 里的 colorPrimary 只是兜底，静态主题那套是 baseline 紫。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/l3_native_action_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorPrimary"
    app:cardCornerRadius="100dp"
    app:cardElevation="0dp"
    app:rippleColor="?attr/colorOnSurface"
    app:strokeWidth="0dp">

  <FrameLayout
      android:id="@+id/l3_native_action_icon"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_margin="10dp" />
</com.google.android.material.card.MaterialCardView>
