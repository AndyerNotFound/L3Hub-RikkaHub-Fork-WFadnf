<?xml version="1.0" encoding="utf-8"?>
<!--
  会话列表的分区标题。三种用途共用：
  - 文件夹段标题：图标 + 名字 + 数量 + 折叠箭头，长按开编辑菜单
  - 日期段标题：只有名字 + 折叠箭头
  - 置顶段标题：图钉 + 「已置顶」，不可折叠

  三种的差异全由 Java 侧按需显示 / 隐藏那几个子 View 来体现。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/l3_native_section_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

  <FrameLayout
      android:id="@+id/l3_native_section_icon"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:layout_marginEnd="6dp"
      android:visibility="gone" />

  <TextView
      android:id="@+id/l3_native_section_label"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textAppearance="?attr/textAppearanceLabelLarge"
      android:textColor="?attr/colorPrimary"
      android:textStyle="bold" />

  <TextView
      android:id="@+id/l3_native_section_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:textAppearance="?attr/textAppearanceLabelMedium"
      android:textColor="?attr/colorOnSurfaceVariant"
      android:visibility="gone" />

  <FrameLayout
      android:id="@+id/l3_native_section_chevron"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:layout_marginStart="6dp" />
</LinearLayout>
