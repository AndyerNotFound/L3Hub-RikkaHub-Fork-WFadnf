<?xml version="1.0" encoding="utf-8"?>
<!--
  收起态 FAB 上的图标：三条横线。

  为什么固定成「菜单」而不是显示第一个槽位的图标：
  FAB 的图标位是 setImageDrawable，塞不进 ComposeView；而 HugeIcons 是 Kotlin 的
  ImageVector，没有对应的 vector drawable。为了这一颗图标去做位图转换不划算，
  而且收起态本来表达的就是「这里有一堆入口」，用菜单图标更准。

  颜色由 FAB 的 app:tint 统一着色，这里写死黑色即可。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillColor="#000000"
      android:pathData="M4,7h16v2H4z" />
  <path
      android:fillColor="#000000"
      android:pathData="M4,11h16v2H4z" />
  <path
      android:fillColor="#000000"
      android:pathData="M4,15h16v2H4z" />
</vector>
