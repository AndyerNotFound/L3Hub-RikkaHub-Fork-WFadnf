<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab 指示线：3dp 高的圆头线条。

  圆角取 3dp（不是 50%）—— 高度也是 3dp，所以上下两个角正好各占一半，
  画出来是一条两端半圆的粗线，与 M3 PrimaryNavigationTab 的
  `ActiveIndicatorShape = RoundedCornerShape(3.0.dp)` 同规格。

  颜色不在这里写死：由 TabLayout 的 `tabIndicatorColor` 统一着色。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <corners android:radius="3dp" />
  <solid android:color="?attr/colorPrimary" />
</shape>
